<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon silhouette. Same plant, one colour.

  It exists separately because a launcher tinting a two-tone drawable flattens the two greens and
  the soil into one shade, and the mark then depends entirely on the gaps between its parts. So the
  stem stops short of the soil bar here: touching, they merge into one blob with a lump on the
  bottom, and the gap is what keeps the bar reading as ground rather than as part of the plant. The
  leaves still meet the stem, which is correct, because they are the same plant.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M54,74 C52.8,68 52.8,63 54,57"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,56 C55,44 62,35 75,34 C76,46 68,55 54,56 Z"
        android:fillColor="#FFFFFF" />

    <path
        android:pathData="M54,67 C50,58 43,53 32,53 C32,62 40,68 54,67 Z"
        android:fillColor="#FFFFFF" />

    <path
        android:pathData="M42,81 L66,81"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
</vector>
