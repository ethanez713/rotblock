<?xml version="1.0" encoding="utf-8"?>
<!--
  A seedling: a stem out of the soil with two leaves, the second one still opening.

  What the mark is for. rotblock is not a wall, it is what grows once the rot stops taking the
  hours, and the old mark said the opposite: two chevrons stopped by a bar, which is a download
  that failed. Drawn after Lucide's `sprout` (ISC), redrawn rather than traced: leaves as filled
  lenses instead of strokes, because a stroked outline at 48px in a launcher fills in and reads as
  a smudge, while a solid shape keeps its silhouette all the way down.

  Everything sits inside the 66dp safe circle of the 108dp adaptive canvas (nothing further than 33
  from 54,54, stroke included), so a circular, squircle or teardrop mask all crop nothing. The leaf
  tip is the furthest thing out at 27.

  The stem is drawn first and ends *under* the upper leaf, so the two read as one plant rather than
  a stick with shapes attached. The soil bar is drawn last for the same reason: it covers the stem's
  round cap, which would otherwise sit on top of the soil rather than in it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem. Bowed very slightly, because a dead-straight stem reads as a pole. -->
    <path
        android:pathData="M54,79 C52.8,70 52.8,63 54,57"
        android:strokeColor="#2F6B4F"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- The new leaf, lighter and higher: the growth, and the thing the eye lands on. -->
    <path
        android:pathData="M54,56 C55,44 62,35 75,34 C76,46 68,55 54,56 Z"
        android:fillColor="#45A873" />

    <!-- The first leaf, darker and lower, on the other side so the mark is not symmetrical. -->
    <path
        android:pathData="M54,67 C50,58 43,53 32,53 C32,62 40,68 54,67 Z"
        android:fillColor="#2F6B4F" />

    <!-- Soil. Warm against the greens, and no wider than the leaves reach. -->
    <path
        android:pathData="M42,78.5 L66,78.5"
        android:strokeColor="#A98156"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />
</vector>
