<?xml version="1.0" encoding="utf-8"?>
<!--
  A scroll that stops: two chevrons falling, the second bigger than the first, and a bar they
  cannot get past.

  Everything sits inside the 66dp safe circle of the 108dp adaptive canvas (nothing further than
  33 from 54,54), so a circular, squircle or teardrop mask all crop nothing. The old mark put a
  rectangle's corners and the tip of a slash right on that boundary, which is why it lost its
  points on a round launcher.

  Every element is a round-capped stroke rather than a filled outline: strokes hold their weight
  when the icon is drawn at 48px in a launcher and at 24px in the app switcher, and the pill ends
  are what keep it from reading as a hamburger menu.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The trail: the same chevron, lighter and smaller, so the pair reads as motion downward. -->
    <path
        android:pathData="M39,29L54,44L69,29"
        android:strokeColor="#6FE3B0"
        android:strokeWidth="6.5"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M36,45L54,63L72,45"
        android:strokeColor="#6FE3B0"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The floor. Warm against the mint, and deliberately no wider than the chevron above it: a
         bar that overhangs turns the whole mark into a download tray. -->
    <path
        android:pathData="M37,77L71,77"
        android:strokeColor="#FF6B61"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
</vector>
