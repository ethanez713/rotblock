<?xml version="1.0" encoding="utf-8"?>
<!--
  The quick-settings tile. The launcher mark redrawn tight to a 24dp box: the tile scales whatever
  it is given, so handing it the launcher foreground drew the glyph at the 61% the adaptive safe
  zone allows and left it looking shrunken next to every stock tile.

  One colour, because the system tints tile icons to say on or off, and a two-tone drawable loses
  that distinction. Unlike the themed launcher icon the stem still meets the soil here: at this size
  the gap that separates them there is under half a pixel, so it buys nothing and only costs the
  stem its length.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M12,21.03 C11.5,17.25 11.5,14.31 12,11.79"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.31"
        android:strokeLineCap="round" />

    <path
        android:pathData="M12,11.37 C12.42,6.33 15.36,2.55 20.82,2.13 C21.24,7.17 17.88,10.95 12,11.37 Z"
        android:fillColor="#FFFFFF" />

    <path
        android:pathData="M12,15.99 C10.32,12.21 7.38,10.11 2.76,10.11 C2.76,13.89 6.12,16.41 12,15.99 Z"
        android:fillColor="#FFFFFF" />

    <path
        android:pathData="M6.96,20.82 L17.04,20.82"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.73"
        android:strokeLineCap="round" />
</vector>
