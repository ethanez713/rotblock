<resources>
    <!-- Window background behind Compose. Must track the Compose theme's `background`, or the
         system window shows through as a mismatched band before/around the content. -->
    <color name="window_background">#FAFAFB</color>

    <!-- Launcher icon backdrop: warm off-white in both modes, because the mark drawn on it is dark
         and a backdrop that followed the theme would invert out from under it. The two are the ends
         of the vertical gradient in drawable/ic_launcher_background.xml, close enough together to
         read as paper rather than as a gradient. -->
    <color name="ic_launcher_background_top">#FDFBF6</color>
    <color name="ic_launcher_background">#EDE7DA</color>
</resources>
