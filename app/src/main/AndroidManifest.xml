<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The block screen. Without this, blocking degrades to ejecting you to the home screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      No RECEIVE_BOOT_COMPLETED, and none is wanted. There is no boot receiver because there is
      nothing to restore at boot: enforcement is whatever PolicyEngine folds out of the stored
      deadlines the next time a window changes, and the accessibility service is rebound by the
      system on its own. A boot receiver would be a wakeup that bought nothing.
    -->

    <!-- Phase 7 greyscale. Grantable only via `adb shell pm grant`; absence is handled, and the
         option is only offered when the grant is actually there. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Package visibility, scoped rather than broad.

      QUERY_ALL_PACKAGES is what this used to ask for, and Play refuses it outright when a scoped
      declaration would do: it is reserved for device search, antivirus, file managers, browsers
      and banking. Both of the lookups this app makes are expressible here, they need no
      permission, and they need no declaration form.

      The two queries are exactly the two questions the UI asks:
        1. "What can the user launch?", for the app picker (AddBlockSheet.loadLaunchableApps).
        2. "Who handles this website?", for a website rule's logo (TargetIcon.handlersFor), which
           is also how a browser is recognised as a browser.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!--
          And http, for one specific reason: "Leave this site" sends a browser to
          BrowserRegistry.ESCAPE_URL with setPackage(), and an intent aimed at a package this app
          cannot see does not resolve. A browser is visible through the https entry above anyway,
          but the escape is the one path where being wrong means a block silently fails to lift.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".RotblockApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rotblock">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PauseRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Rotblock" />

        <activity
            android:name=".ui.FrictionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Rotblock" />

        <service
            android:name=".pause.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_rotblock"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".diag.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_rotblock"
            android:label="@string/diagnostics_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          exported MUST be true: the system binds this from another process, and the
          BIND_ACCESSIBILITY_SERVICE permission is what keeps anyone else out. With exported="false"
          the service simply never appears in Settings > Accessibility and nothing is enforced.
        -->
        <service
            android:name=".service.RotblockAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
